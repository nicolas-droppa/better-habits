<h1 class='text-3xl semibold'> List of my habits! <h1>

<table class='mt-6 w-full'>
    <thead>
        <tr class='bg-sky-100 text-left'>
            <th class='py-3 px-4'>Date</th>
            <th>Title</th>
            <th>Description</th>
            <th>Duration [min]</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% @habits.each do |habit| %>
            <tr>
                <td class='py-3 px-3'><%= habit.scheduled_at.strftime("%d.%m.%Y o %H:%M") %></td>
                <td><%= habit.title %></td>
                <td><%= habit.description %></td>
                <td><%= habit.duration_in_min %></td>
                <td>
                    <div class='flex'>
                        <%= 'Edit' %>
                        <%= 'Delete' %>
                    </div>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>