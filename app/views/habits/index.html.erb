<div class="max-w-7xl mx-auto p-6">
  <div class="flex items-center justify-between mb-8 bg-white p-4 rounded-xl shadow-sm border border-slate-200">
    <div>
      <h1 class="text-3xl font-bold text-slate-800">
        <%= @current_date.strftime("%B %Y") %>
      </h1>
      <p class="text-slate-500 text-sm">Monthly Habit Overview</p>
    </div>

    <div class="flex items-center space-x-3">
      <%= link_to habits_path(year: @prev_month.year, month: @prev_month.month), class: "px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-lg transition" do %>
        ← Previous
      <% end %>

      <%= link_to habits_path(year: Date.today.year, month: Date.today.month), class: "px-4 py-2 bg-sky-50 text-sky-600 hover:bg-sky-100 font-semibold rounded-lg border border-sky-200 transition" do %>
        Today
      <% end %>

      <%= link_to habits_path(year: @next_month.year, month: @next_month.month), class: "px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-lg transition" do %>
        Next →
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-7 gap-4 mb-2 text-center font-bold text-slate-500 text-xs uppercase tracking-wider">
    <div>Mon</div>
    <div>Tue</div>
    <div>Wed</div>
    <div>Thu</div>
    <div>Fri</div>
    <div>Sat</div>
    <div>Sun</div>
  </div>

  <div class="grid grid-cols-7 gap-4">
    <% @calendar_days.each do |day| %>
      <% if day.nil? %>
        <div class="min-h-[160px] p-3 rounded-xl bg-slate-50/50 border border-dashed border-slate-200 opacity-40"></div>
      <% else %>
        <% 
          day_habits = @habits_by_date[day] || []
          is_today = day == Date.today
          is_past = day < Date.today
        %>

        <div class="min-h-[160px] p-3 rounded-xl border flex flex-col justify-between transition shadow-sm
                    <%= is_today ? 'bg-sky-50/50 border-sky-400 ring-2 ring-sky-200' : 'bg-white border-slate-200' %>">
          
          <div>
            <div class="flex justify-end items-center mb-2 border-b border-slate-100 pb-1">
              <span class="text-sm font-bold <%= is_today ? 'bg-sky-500 text-white w-6 h-6 rounded-full flex items-center justify-center' : 'text-slate-700' %>">
                <%= day.day %>
              </span>
            </div>

            <% if day_habits.any? %>
              <div class="space-y-1.5 mt-2">
                <% day_habits.sort_by(&:scheduled_at).each do |habit| %>
                  <% 
                    start_time = habit.scheduled_at.strftime("%H:%M")
                    end_time = (habit.scheduled_at + habit.duration_in_min.minutes).strftime("%H:%M")
                  %>
                  <div class="p-1.5 bg-slate-50 border border-slate-200 rounded text-xs hover:border-sky-300 transition">
                    <div class="font-semibold text-slate-500 text-[10px]">
                      <%= start_time %> - <%= end_time %>
                    </div>
                    <div class="font-bold text-slate-800 truncate" title="<%= habit.title %>">
                      <%= habit.title %>
                    </div>
                  </div>
                <% end %>
              </div>

            <% else %>
              <div class="mt-4 text-center px-1">
                <% if is_past %>
                  <p class="text-[11px] text-rose-400 font-medium italic">
                    No progress today
                  </p>
                <% else %>
                  <p class="text-[11px] text-slate-400 italic">
                    <%= @motivational_quotes.sample %>
                  </p>
                <% end %>
              </div>
            <% end %>
          </div>

        </div>
      <% end %>
    <% end %>
  </div>
</div>